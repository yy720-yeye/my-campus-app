{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "node server/index.js",
    "healthcheckPath": "/api/canteens",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS"
  }
}